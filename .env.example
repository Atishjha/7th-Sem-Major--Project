# Copy this file to .env and adjust as needed.
# Nothing here is a real secret — these are demo/dev defaults.

ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://socuser:socpassword@postgres:5432/soc_db

# --- Auth ---
JWT_SECRET_KEY=CHANGE_ME_DEMO_SECRET_NOT_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI provider abstraction ---
# AI_PROVIDER=mock is the default and requires no key.
# Set to gemini | groq | openai_compatible | openrouter to use a real LLM.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
