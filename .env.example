# Copy this file to .env and adjust as needed.
# Nothing here is a real secret — these are demo/dev defaults.

ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://socuser:socpassword@postgres:5432/soc_db

# --- First-run bootstrap ---
# Create the demo accounts (admin/analyst/viewer, see README) on startup if
# missing. Fine for the academic demo; set to false for anything real.
SEED_DEMO_USERS=true

# --- Auth ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_DEMO_SECRET_NOT_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI provider abstraction ---
# AI_PROVIDER=mock is the default and requires no key.
# Set to groq | openrouter | openai_compatible to use a real LLM
# (openai_compatible works with any OpenAI-style endpoint via AI_BASE_URL).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Only for AI_PROVIDER=openai_compatible (e.g. a local Ollama gateway):
AI_BASE_URL=
