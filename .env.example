# Copy this file to .env and adjust as needed.
# Nothing here is a real secret — these are demo/dev defaults.

ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://socuser:socpassword@postgres:5432/soc_db

# --- First-run bootstrap ---
# Create the demo accounts (admin/analyst/viewer, see README) on startup if
# missing. Fine for the academic demo; set to false for anything real.
SEED_DEMO_USERS=true

# --- Auth ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_DEMO_SECRET_NOT_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI provider abstraction ---
# AI_PROVIDER=mock is the default and needs no key (offline analyst).
# To use a real model, set a provider and a key, then restart the backend:
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...        (from https://console.groq.com/keys; NEVER commit this file)
#   AI_MODEL=                 (empty = llama-3.3-70b-versatile for groq; catalogues change, see the provider's models page)
# Providers: groq | openrouter | openai_compatible. openrouter and openai_compatible need AI_MODEL;
# openai_compatible also needs AI_BASE_URL (any OpenAI-style endpoint).
# Check it works:  python scripts/check_ai.py   (details: docs/ai-analyst.md)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
